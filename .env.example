# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose this to the browser or commit it.
# Used only by the Netlify scheduled function to read/write across all rows.
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (https://app.brevo.com) - Settings -> SMTP & API -> API Keys
BREVO_API_KEY=
# Must be a single sender you verified in Brevo (Senders, Domains & Dedicated IPs -> Senders)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=APS PrimeHomes Notifications
